# =============================================================
# 多智能体动漫追番推荐系统 —— 环境变量模板
# 使用方法：复制为 .env 后按本机情况填写，切勿把 .env 提交到 git
# 详细说明见 docs/config-guide.md
# =============================================================

# ---------- 运行环境 ----------
# dev / test / prod
APP_ENV=dev
APP_NAME=anirec
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=anirec
MYSQL_POOL_SIZE=10

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REC_CACHE_TTL=86400

# ---------- LLM（OpenAI 兼容接口，可切换云端或本地 Ollama）----------
# 云端示例：DashScope / DeepSeek
LLM_PROVIDER=dashscope
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30
LLM_MAX_RETRY=2
# 本地 Ollama 备选：LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_MODEL=qwen2.5:7b

# ---------- 模型路径 ----------
MODEL_DIR=./data/checkpoints
SASREC_CKPT=sasrec_best.pt
MULTI_INTEREST_CKPT=multi_interest.pt
CONTENT_ENCODER_DIR=./models/content_encoder/pretrained
ITEM_EMB_PATH=./data/features/item_emb.npy
CONTENT_VEC_PATH=./data/features/content_vec_512.npy

# ---------- 数据集路径 ----------
DATA_DIR=./dataset
ANIME_META_PATH=./dataset/animes.csv
RATING_PATH=./dataset/ratings.csv
GENRE_MAP_PATH=./dataset/id_to_genreids.json
DATASET_PKL=./dataset/dataset.pkl
NEG_SAMPLE_PKL=./dataset/random-sample_size100-seed98765.pkl

# ---------- 算法超参 ----------
MAX_SEQ_LEN=50
NUM_INTERESTS=4
HIDDEN_SIZE=64
NUM_LAYERS=2
NUM_HEADS=2
DROPOUT=0.2
BATCH_SIZE=256
LR=0.001
EPOCHS=200
EARLY_STOP_PATIENCE=10
# 冷启动判定阈值（交互数低于该值视为新番）
COLD_START_THRESHOLD=10
# 排序侧融合权重：行为得分 : 内容得分
FUSION_W_BEHAVIOR=0.7
FUSION_W_CONTENT=0.3
FUSION_W_CONTENT_COLD=0.5

# ---------- 定时任务 ----------
CRON_OFFLINE_REC=0 3 * * *
CRON_NEW_ANIME_SYNC=0 4 * * 1

# ---------- 安全 ----------
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- 前端 ----------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# ---------- 代码仓库 ----------
# GitHub 远程仓库（项目源码托管地址）
GIT_REPO_URL=https://github.com/zarbzarb/animes.git
GIT_REPO_BRANCH=main
