# ===== 环境变量（含密钥，禁止提交）=====
.env
.env.local
.env.*.local
!.env.example

# ===== 数据与模型产物（体积大，走网盘/Release，不入库）=====
dataset/*.csv
dataset/*.pkl
dataset/*.npy
dataset/*.dat
dataset/*.pth
data/raw/
data/processed/
data/features/
data/checkpoints/
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors
!dataset/.gitkeep

# 预训练权重（体积大，由 scripts/download_content_encoder.py 拉取）
models/content_encoder/pretrained/
models/**/pretrained/

# ===== 日志与运行时 =====
logs/
*.log
tmp/
.tmp/
celerybeat-schedule
*.pid
*.sqlite3
*.db

# 变异测试脚本的临时备份（正常情况下脚本会自行删除；异常中断时残留，勿入库）
*.mutation-backup

# ===== 前端 =====
node_modules/
frontend/dist/
frontend/.vite/
frontend/node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== 实验产物 =====
experiments/
results/
*.png
*.pdf
!docs/assets/**/*.png
!docs/assets/**/*.svg

# ===== IDE / OS =====
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

